      "name": "Kraken Slayer",
      "notes": "1.25x DMG, 1.25x ROF, Every 3rd bullet will deal additional 20 damage on hit. This extra damage increases based on the floor up to 40 damage. This extra damage will also scale with missing health up to 1.75x damage."
    },
    "LOLItems:fated_ashes": {
      "name": "Fated Ashes",
      "notes": "Dealing damage applies a burn on the enemy that does 3 damage per second for 3 seconds."
    },
