      "notes": "1 Heart, 10% chance to deny taking damage."
    },
    "LOLItems:the_collector": {
      "name": "The Collector",
      "notes": "1.1x DMG, All bullets execute enemies below 15% max health. 30% chance to drop 1 extra casing on kill."
    },
    "LOLItems:cull": {
      "name": "Cull",
      "notes": "Gain 1 extra casing every 5 kills. After 200 kills, gain a one time drop of 30 casings."
    },
    "LOLItems:detonation_orb": {
      "name": "Detonation Orb",
      "notes": "Dealing damage to an enemy stores 25% of that damage. Damage accumulates with more damage and detonates after 3 seconds of no damage. Will immediately detonate if stored damage is enough to kill."
    },
    "LOLItems:experimental_hexplate": {
      "name": "Experimental Hexplate",
      "notes": "1.1x DMG, 1.1x ROF, 1 Heart, On item activation, provide Overdrive buff to player. Overdrive lasts for 8s, has a 30s cooldown, and provides a 1.5x ROF and 1.25x MOVSPD buff."
    },
    "LOLItems:frozen_heart_lolitems": {
      "name": "Frozen Heart",
      "notes": "1 Armor, Applies a 30% cripple to nearby enemies. Cripple: slows target's ROF by certain amount."
    },
    "LOLItems:guardian_angel": {
      "name": "Guardian Angel",
      "notes": "1.25x DMG, 2 Armor, Triggers Rebirth on death. Rebirth: become invulnerable for 4 seconds, sets health to 50% of player's max hearts, then triggers a blank at the end of the invulnerability. Rebirth cannot trigger again."
    },
    "LOLItems:guinsoo's_rageblade": {
      "name": "Guinsoo's Rageblade",
      "notes": "1.25x DMG, 1.2x ROF, Every 3rd bullet fired, an extra projectile copied from that 3rd projectile will fire after a slight delay. This bullet is tinted red and does not consume any ammo."
    },
    "LOLItems:horizon_focus": {
      "name": "Horizon Focus",
      "notes": "1.1x DMG, Increases each bullet's damage by up to 25% based on how far the hit target is from the player."
