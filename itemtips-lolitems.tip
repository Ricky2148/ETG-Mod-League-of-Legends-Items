  "items": {
    "LOLItems:blade_of_the_ruined_king": {
      "name": "Blade of the Ruined King",
      "notes": "1.25x DMG, 1.2x ROF, First bullet of clip slows targets hit by 50% for 3s. All player bullets deal 12% current health damage on hit. (25% effective against bosses)"
    },
    "LOLItems:cloak_of_starry_night": {
      "name": "Cloak of Starry Night",
      "notes": "1 Heart, 10% chance to deny taking damage."
    },
    "LOLItems:shield_of_molten_stone": {
